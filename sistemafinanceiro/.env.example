# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Copie este arquivo para .env.local e preencha com suas credenciais

# Seu projeto Supabase URL (sem /rest/v1)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Sua chave pública (anon) do Supabase
VITE_SUPABASE_ANON_KEY=seu_anon_key_aqui

# ============================================================================
# Como obter estas chaves:
# 1. Acesse https://app.supabase.com
# 2. Vá para Project Settings > API
# 3. Copie a URL do projeto e a chave "anon" (públic key)
# 4. Cole nos campos acima
# ============================================================================
